; CALLOFBRAWL — mobile-first FPS Team Deathmatch
; Godot Engine 4.x project file (Compatibility renderer for the widest Android coverage)
;
; The three provided GLB assets live at the repository root and are referenced
; directly (res://de_dust2_-_cs_map.glb, res://army_character_1.glb,
; res://ak47_with_scope.glb) so their original location is preserved.

config_version=5

[application]

config/name="CALLOFBRAWL"
config/description="Mobile-first FPS Team Deathmatch on de_dust2."
config/version="1.0.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/core/settings_manager.gd"
Game="*res://scripts/core/game_manager.gd"
Audio="*res://scripts/core/audio_manager.gd"
Fx="*res://scripts/core/effects_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[gui]

theme/default_font_multichannel_signed_distance_field=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
3d/default_gravity=18.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=1
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
camera/depth_of_field/depth_of_field_bokeh_quality=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.32, 0.46, 0.62, 1)
environment/defaults/default_environment=""

[audio]

; Android headroom: 44.1 kHz mixer with a small buffer. The Music bus is created at
; runtime by Audio._ensure_bus(), so no bus layout file is needed.
driver/output_latency=20
driver/mix_rate=44100

[threading]

worker_pool/max_threads=2

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0

[android]

; Landscape-only mobile game (the runtime also enforces landscape via
; Settings.apply_graphics -> DisplayServer.screen_set_orientation).
module/package_name="com.callofbrawl.fps"
architectures/arm64-v8a=true
architectures/armeabi-v7a=true
version/code=1
version/name="1.0.0"
export_format=1

